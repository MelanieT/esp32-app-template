# Settings for the app. idf.py menuconfig, then idf.py save-defconfig, writes this file.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=2048
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_WIFI_NVS_ENABLED=n

# Wifi setup through an access point and the web interface
CONFIG_USE_SETUP_WEB_INTERFACE=y
CONFIG_START_WEBSERVER_IN_STATION_MODE=y
CONFIG_AP_MODE_HOSTNAME_PREFIX="esp32-app"
CONFIG_WEB_INTERFACE_DIR="/Users/melanie/Projects/wifi-configurator/dist-template"

# OTA, the server URIs belong here, not in code
CONFIG_OTA_SERVER_URI=""
CONFIG_SPIFFS_OTA_URI=""
